# Optional: Google Tag Manager container
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional: real GA4 measurement ID. If omitted, the local mock dataLayer event still fires.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Optional: Meta Pixel ID. If omitted, the local mock event still fires.
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Optional: Google Apps Script / Make / Zapier / CRM webhook.
# POST receives JSON: { id, name, email, company, budget, receivedAt }
CRM_WEBHOOK_URL=
